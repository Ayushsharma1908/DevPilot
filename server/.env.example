# Gemini 2.5 Flash powers DevPilot's architecture analysis and failure diagnosis.
# Without this set, DevPilot falls back to a clearly-labeled offline mock so the
# rest of the product still works during local development.
GEMINI_API_KEY=

# Set to false to attempt real Zerops deployments via zcli (requires zcli on PATH
# and ZEROPS_TOKEN below). Defaults to true (simulated pipeline) for demo/dev.
DEMO_MODE=true

# Zerops personal access token, used by zcli for real-mode deployments.
# See https://docs.zerops.io/references/cli
ZEROPS_TOKEN=

PORT=8787
